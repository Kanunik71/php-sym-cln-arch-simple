# Loaded from tests/bootstrap.php when PHPUnit runs inside the php container.
# Host PHPUnit keeps using .env.test (127.0.0.1:5432 → published postgres port).
DATABASE_URL="postgresql://app:app@postgres:5432/app?serverVersion=16&charset=utf8"
REDIS_URL=redis://redis:6379
MESSENGER_TRANSPORT_DSN=in-memory://
MESSENGER_FAILURE_TRANSPORT_DSN=in-memory://
MAILER_DSN=null://null
MAILER_FROM=noreply@example.com
