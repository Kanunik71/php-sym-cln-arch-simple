APP_ENV=dev
APP_SECRET=change_me_in_production_please_use_random_string

DATABASE_URL="mysql://app:app@127.0.0.1:3306/app?serverVersion=8.0&charset=utf8mb4"
REDIS_URL=redis://127.0.0.1:6380
MESSENGER_TRANSPORT_DSN=amqp://guest:guest@127.0.0.1:5673/%2f/messages

JWT_SECRET=change_me_jwt_secret_must_be_at_least_32_characters_long

CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

DEFAULT_URI=http://localhost:8080

SCHEDULER_FILE_CLEANUP_CRON="0 3 * * *"

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> notifications ###
MAILER_FROM=noreply@example.com
###< notifications ###
