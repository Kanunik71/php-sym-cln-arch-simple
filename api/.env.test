KERNEL_CLASS='App\Kernel'
APP_SECRET=test_secret
JWT_SECRET=test_jwt_secret_must_be_at_least_32_characters_long
# Host PHPUnit: port 5432 → docker postgres:5432; doctrine dbname_suffix adds _test → app_test
# Inside the php container, tests/bootstrap.php overloads .env.test.docker instead.
DATABASE_URL="postgresql://app:app@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
REDIS_URL=redis://127.0.0.1:6380
MESSENGER_TRANSPORT_DSN=in-memory://
MESSENGER_FAILURE_TRANSPORT_DSN=in-memory://
SCHEDULER_FILE_CLEANUP_CRON="0 3 * * *"
MAILER_DSN=null://null
MAILER_FROM=noreply@example.com
